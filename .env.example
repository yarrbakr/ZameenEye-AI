# ZameenEye AI — copy to `.env` in the project ROOT (never in src/) and fill in real values.
# `.env` is git-ignored; this `.env.example` is committed. NEVER put real secrets here.

# ============================================================
# BACKEND (TypeScript) — see SETUP.md
# ============================================================
# Supabase SESSION POOLER string (NOT Direct/IPv6, NOT Transaction pooler :6543).
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Server port (defaults to 3000 if unset).
PORT=3000

# ============================================================
# AI PIPELINE (Python) — Fireworks + FIRMS
# ============================================================
# Which LLM provider generate_advisory() calls. Default: fireworks.
# Set to `mistral` to test the loop with Mistral while Fireworks credits are pending.
LLM_PROVIDER=fireworks
# Fireworks API key (live inference; credits drop Day 5).
FIREWORKS_API_KEY=
# Mistral La Plateforme (stopgap when LLM_PROVIDER=mistral). Get a key at console.mistral.ai.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# NASA FIRMS map key (ingestion).
FIRMS_MAP_KEY=

# ============================================================
# VOICE SERVICE (Python) — WhatsApp webhook + ASR (Abu Bakr)
# ============================================================
# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
GRAPH_VERSION=v22.0
# --- Where the voice service reaches Kai's spatial endpoint (his TS server) ---
SPATIAL_CHECK_URL=http://localhost:3000/spatial-check
# --- Phone -> landId demo map (JSON). PRIMARY demo path: uncle's number -> his land. ---
#     e.g. PHONE_LAND_MAP={"923001234567":"<land-uuid>"}
PHONE_LAND_MAP={}
# --- faster-whisper ASR (CPU; no AMD needed). ur = Urdu. ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANG=ur
